# Copy to .env on the server (never commit .env)
OPENAI_API_KEY=sk-your-key-here

# ElevenLabs (per-scene voice-over) — leave blank to skip VO generation
ELEVEN_API_KEY=
# ELEVEN_VOICE_ID=VuLPiW02W0Qm8465ksBZ
# ELEVEN_MODEL_ID=eleven_multilingual_v2
# ELEVEN_STABILITY=0.26
# ELEVEN_SIMILARITY_BOOST=0.33
# ELEVEN_STYLE=0.07
# ELEVEN_SPEED=0.7
# ELEVEN_OUTPUT_FORMAT=wav_44100

# Optional model overrides
# OPENAI_TEXT_MODEL=gpt-5.4-mini
# IMAGE_MODEL=gpt-image-2

# Optional tuning
# MAX_WORKERS=3
# REGEN_PARALLELISM=4
# VOICE_WORKERS=3
