# Copy to .env on the server (never commit .env)
OPENAI_API_KEY=sk-your-key-here

# ElevenLabs — voice-over + sentence timestamps (/with-timestamps, eleven_v3)
ELEVEN_API_KEY=
# ELEVEN_VOICE_ID=VuLPiW02W0Qm8465ksBZ
# ELEVEN_MODEL_ID=eleven_v3
# ELEVEN_STABILITY=0.75
# ELEVEN_SIMILARITY_BOOST=0.85
# ELEVEN_STYLE=0.07
# Max characters per /with-timestamps request (eleven_v3 safe limit ~2500)
# ELEVEN_TIMESTAMP_CHUNK_CHARS=2000
# ELEVEN_REQUEST_TIMEOUT=300

# Optional model overrides
# OPENAI_TEXT_MODEL=gpt-5.4-mini
# IMAGE_MODEL=gpt-image-2

# Preview-only duration estimate: characters of script per minute of narration
# CHARS_PER_MINUTE=1200
# Voice-over cost per minute used in the cost estimate
# VOICE_COST_PER_MINUTE=0.186

# Image generation safety retries when content policy blocks a prompt
# IMAGE_SAFETY_MAX_RETRIES=5

# Optional tuning (raise on multi-core VPS)
# MAX_WORKERS=4
# REGEN_PARALLELISM=3
# EXPORT_FFMPEG_WORKERS=8
# THUMB_MAX_WIDTH=1280
# THUMB_JPEG_QUALITY=82
