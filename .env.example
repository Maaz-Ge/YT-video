# Copy to .env on the server (never commit .env)
OPENAI_API_KEY=sk-your-key-here

# ElevenLabs (one combined voice-over for the whole script) — leave blank to skip VO
ELEVEN_API_KEY=
# ELEVEN_VOICE_ID=VuLPiW02W0Qm8465ksBZ
# ELEVEN_MODEL_ID=eleven_multilingual_v2
# ELEVEN_STABILITY=0.26
# ELEVEN_SIMILARITY_BOOST=0.33
# ELEVEN_STYLE=0.07
# ELEVEN_SPEED=1.0
# ELEVEN_OUTPUT_FORMAT=wav_44100
# Fixed seed → consistent timbre across all chunks of the combined audio
# ELEVEN_SEED=12345
# Max characters per ElevenLabs request (hard cap is 10000); script is chunked below this
# VOICE_MAX_CHARS=9000

# Optional model overrides
# OPENAI_TEXT_MODEL=gpt-5.4-mini
# IMAGE_MODEL=gpt-image-2

# Speech-to-text for sentence-level scene timing (word timestamps require whisper-1)
# STT_MODEL=whisper-1
# Max bytes per STT upload; OpenAI hard-caps transcription requests at 25 MB
# STT_MAX_UPLOAD_BYTES=25165824

# Preview-only duration estimate: characters of script per minute of narration
# CHARS_PER_MINUTE=1200
# Voice-over cost per minute used in the cost estimate (ElevenLabs TTS + whisper STT)
# VOICE_COST_PER_MINUTE=0.186

# Optional tuning (raise on multi-core VPS; defaults are conservative)
# MAX_WORKERS=6
# REGEN_PARALLELISM=6
# EXPORT_FFMPEG_WORKERS=8
# THUMB_MAX_WIDTH=1280
# THUMB_JPEG_QUALITY=82
